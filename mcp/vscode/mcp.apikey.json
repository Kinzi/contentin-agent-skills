{
  "inputs": [
    {
      "type": "promptString",
      "id": "contentin-key",
      "description": "ContentIn MCP key (app.contentin.io, Profiles, Connections)",
      "password": true
    }
  ],
  "servers": {
    "contentin": {
      "type": "http",
      "url": "https://mcp.contentin.io/mcp-server",
      "headers": {
        "X-MCP-Key": "${input:contentin-key}"
      }
    }
  }
}
